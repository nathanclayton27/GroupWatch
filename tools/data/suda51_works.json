{
  "claims": {
    "after_split": {
      "page": "Grasshopper Manufacture",
      "text": "The company's first title developed after the split was Travis Strikes Again: No More Heroes"
    },
    "anime_tieins": {
      "page": "Grasshopper Manufacture",
      "text": "Potential losses were often made up by the development of games based on popular anime franchises, such as Samurai Champloo: Sidetracked, Blood+: One Night Kiss, and Rebuild of Evangelion: Sound Impact"
    },
    "bksword_kurayami": {
      "page": "Black Knight Sword",
      "text": "The storyline and tone were based on an early draft of Kurayami"
    },
    "capcom_five": {
      "page": "Goichi Suda",
      "text": "Development began in 2002 as part of a pentalogy of video games dubbed the Capcom Five"
    },
    "fatalframe_codirector": {
      "page": "Goichi Suda",
      "text": "Suda worked as a designer, co-director and co-writer on Fatal Frame: Mask of the Lunar Eclipse, the fourth entry in the Fatal Frame series"
    },
    "fatalframe_collab": {
      "page": "Goichi Suda",
      "text": "The project was a collaboration between Tecmo Koei, Grasshopper Manufacture and Nintendo SPD"
    },
    "fatalframe_remaster": {
      "page": "Grasshopper Manufacture",
      "text": "Remastered with improved assets and character models."
    },
    "firepro_dlc": {
      "page": "Fire Pro Wrestling World",
      "text": "Another DLC pack titled \"Fighting Road: Champion Road Beyond\""
    },
    "firepro_fame": {
      "page": "Super Fire Pro Wrestling Special",
      "text": "The game's scenario was written by Goichi Suda, and helped make him famous"
    },
    "first_job": {
      "page": "Goichi Suda",
      "text": "Suda's first job at Human was as a director for Super Fire Pro Wrestling III (1993)"
    },
    "founded": {
      "page": "Grasshopper Manufacture",
      "text": "The company was founded on March 30, 1998"
    },
    "fsr_ds_port": {
      "page": "Grasshopper Manufacture",
      "text": "Expanded port with additional puzzles."
    },
    "guild01": {
      "page": "Goichi Suda",
      "text": "Suda was one of four major Japanese developers to contribute to the compilation video game Guild01"
    },
    "gungho": {
      "page": "Grasshopper Manufacture",
      "text": "On 30 January 2013, Grasshopper Manufacture was acquired by GungHo Online Entertainment."
    },
    "gungho_first": {
      "page": "Grasshopper Manufacture",
      "text": "Their first title released under GungHo was Let It Die"
    },
    "gunn": {
      "page": "Goichi Suda",
      "text": "He collaborated on Lollipop Chainsaw with American writer-director James Gunn"
    },
    "killer7_first_west": {
      "page": "Goichi Suda",
      "text": "Killer7, Suda's first title to be released outside Japan"
    },
    "kinect": {
      "page": "Diabolical Pitch",
      "text": "for the Xbox 360 Kinect"
    },
    "kurayami_manga": {
      "page": "Shadows of the Damned",
      "text": "The two volume manga Kurayami Dance: Dance in the Dark, first published in 2015 and written by Suda 51"
    },
    "libmaiden_guild": {
      "page": "Liberation Maiden",
      "text": "It was originally included in the Guild01 compilation for the Nintendo 3DS in 2012, and later made available separately on Nintendo eShop"
    },
    "michigan_producer": {
      "page": "Michigan: Report from Hell",
      "text": "Company founder Goichi Suda created the initial concept, and acted as a producer"
    },
    "mikami_shadows": {
      "page": "Goichi Suda",
      "text": "Suda collaborated with Mikami on both Killer7 and Shadows of the Damned"
    },
    "moonlight_last": {
      "page": "Goichi Suda",
      "text": "Moonlight Syndrome would be the last game worked on by Suda for Human Entertainment"
    },
    "netease": {
      "page": "Grasshopper Manufacture",
      "text": "Grasshopper was acquired from GungHo by NetEase Games by October 2021"
    },
    "nmh3_final": {
      "page": "Goichi Suda",
      "text": "the third and intended final mainline entry No More Heroes III (2021)"
    },
    "not_directed_since": {
      "page": "Grasshopper Manufacture",
      "text": "the games mark Goichi Suda's return to a directorial role, having not directed a game since the original No More Heroes in 2007"
    },
    "ranko_kataoka": {
      "page": "Goichi Suda",
      "text": "Suda created the initial concept, then gave the project to Tokyo Jungle producer Yohei Kataoka"
    },
    "ranko_writer": {
      "page": "Short Peace",
      "text": "The game's story was written by Goichi Suda"
    },
    "returned_director": {
      "page": "Goichi Suda",
      "text": "Suda returned as a director for the next two titles in the No More Heroes series"
    },
    "romeo_selfpub": {
      "page": "Romeo is a Dead Man",
      "text": "developed and published by Grasshopper Manufacture"
    },
    "sdatcher": {
      "page": "Goichi Suda",
      "text": "Suda collaborated with Hideo Kojima as scenario writer for Sdatcher, a radio drama"
    },
    "shadows_kurayami": {
      "page": "Shadows of the Damned",
      "text": "Kurayami ultimately served the first incarnation of Shadows of the Damned"
    },
    "shortpeace_four": {
      "page": "Short Peace",
      "text": "a multimedia project composed of four short anime films"
    },
    "silvercase_debut": {
      "page": "Goichi Suda",
      "text": "Its debut title was The Silver Case for the PlayStation"
    },
    "silvercase_remaster": {
      "page": "Grasshopper Manufacture",
      "text": "HD remaster."
    },
    "sinemora_dev": {
      "page": "Sine Mora",
      "text": "developed by Digital Reality and Grasshopper Manufacture"
    },
    "sinemora_ex": {
      "page": "Sine Mora",
      "text": "an extended version of Sine Mora for Nintendo Switch, PlayStation 4, Windows and Xbox One"
    },
    "split_2018": {
      "page": "Grasshopper Manufacture",
      "text": "In 2018, the company would post a notice of an absorption-type split over issues in management"
    },
    "suehiro_collab": {
      "page": "Hidetaka Suehiro",
      "text": "they decided to collaborate on a horror title. Just before the stream, Suda titled it Hotel Barcelona"
    },
    "suehiro_known": {
      "page": "Hidetaka Suehiro",
      "text": "His best-known work include the games Spy Fiction, Deadly Premonition"
    },
    "supervisory": {
      "page": "Goichi Suda",
      "text": "Following No More Heroes, Suda took on a supervisory role for the majority of future Grasshopper projects"
    },
    "tokio_short": {
      "page": "Tokio of the Moon's Shadow",
      "text": "Title = Tokio of the Moon's Shadow"
    },
    "travis_spinoff": {
      "page": "Goichi Suda",
      "text": "the spin-off Travis Strikes Again (2019)"
    },
    "twilight_jp_only": {
      "page": "Twilight Syndrome",
      "text": "is a horror-themed adventure game series released exclusively in Japan"
    },
    "twilight_split": {
      "page": "Twilight Syndrome",
      "text": "were initially planned to be one game, but were split into two volumes due to development timelines"
    },
    "twilight_suda": {
      "page": "Twilight Syndrome",
      "text": "The first two games were directed by Goichi Suda and released for the PlayStation in 1996. Suda entered the position partway through development"
